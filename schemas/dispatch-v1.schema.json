{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iteathen/PATCH-POLLER/schemas/dispatch-v1.schema.json",
  "title": "PATCH-POLLER dispatch v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "dispatch_id",
    "issued_at",
    "expires_at",
    "context",
    "target",
    "operation",
    "requested_capabilities",
    "reporting"
  ],
  "properties": {
    "version": { "const": 1 },
    "dispatch_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "context": { "$ref": "#/$defs/context" },
    "target": { "$ref": "#/$defs/target" },
    "operation": { "$ref": "#/$defs/operation" },
    "requested_capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "workspace.read",
          "workspace.write",
          "process.execute",
          "git.worktree.create",
          "git.commit",
          "git.push",
          "github.report"
        ]
      }
    },
    "reporting": { "$ref": "#/$defs/reporting" }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*[\\u0000-\\u001F]).+$"
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "trust", "text", "source", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "kind": {
          "type": "string",
          "enum": ["objective", "checkpoint", "constraint", "decision", "evidence", "warning", "result", "handoff"]
        },
        "trust": {
          "type": "string",
          "enum": ["trusted_instruction", "repository_authority", "observed_evidence", "untrusted_content"]
        },
        "text": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reference"],
          "properties": {
            "kind": { "type": "string", "enum": ["controller", "github", "repository", "local_observation", "prior_handoff"] },
            "reference": { "type": "string", "minLength": 1, "maxLength": 4096 }
          }
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "objective", "checkpoint", "constraints", "frames"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "revision": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "objective": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "checkpoint": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "constraints": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
        },
        "frames": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/frame" }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_id", "checkout", "repository", "branch", "expected_head", "allowed_paths"],
      "properties": {
        "workspace_id": { "$ref": "#/$defs/safeId" },
        "checkout": { "$ref": "#/$defs/relativePath" },
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", "maxLength": 200 },
        "branch": { "type": "string", "minLength": 1, "maxLength": 255 },
        "expected_head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "allowed_paths": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        }
      }
    },
    "stdin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "enum": ["none", "literal", "context_bundle"] },
        "text": { "type": "string", "maxLength": 131072 }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "literal" } } },
          "then": { "required": ["text"] },
          "else": { "not": { "required": ["text"] } }
        }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tool_id", "args", "cwd", "stdin"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "tool_id": { "$ref": "#/$defs/safeId" },
        "args": {
          "type": "array",
          "maxItems": 128,
          "items": { "type": "string", "maxLength": 4096 }
        },
        "cwd": { "$ref": "#/$defs/relativePath" },
        "stdin": { "$ref": "#/$defs/stdin" },
        "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 86400000 }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "steps"],
      "properties": {
        "kind": { "const": "tool_sequence" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/step" }
        }
      }
    },
    "reporting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_update_interval_seconds", "maximum_silence_seconds", "include_context_handoff"],
      "properties": {
        "minimum_update_interval_seconds": { "type": "integer", "minimum": 30, "maximum": 3600 },
        "maximum_silence_seconds": { "type": "integer", "minimum": 60, "maximum": 86400 },
        "include_context_handoff": { "type": "boolean" }
      }
    }
  }
}
