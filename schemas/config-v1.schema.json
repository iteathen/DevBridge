{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iteathen/PATCH-POLLER/schemas/config-v1.schema.json",
  "title": "PATCH-POLLER local configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "state", "github", "workspaces", "tools", "reporting"],
  "properties": {
    "version": { "const": 1 },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database_path"],
      "properties": {
        "database_path": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_base_url", "api_version", "token_env", "user_agent", "poll", "mailboxes"],
      "properties": {
        "api_base_url": { "type": "string", "format": "uri" },
        "api_version": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "token_env": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "user_agent": { "type": "string", "minLength": 1, "maxLength": 200 },
        "poll": { "$ref": "#/$defs/poll" },
        "mailboxes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/mailbox" }
        }
      }
    },
    "workspaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/workspace" }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/tool" }
    },
    "reporting": { "$ref": "#/$defs/reporting" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "poll": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_interval_ms", "idle_interval_ms", "maximum_idle_interval_ms", "jitter_ratio", "conservation_remaining", "critical_reserve_remaining", "conservation_ratio"],
      "properties": {
        "active_interval_ms": { "type": "integer", "minimum": 30000, "maximum": 3600000 },
        "idle_interval_ms": { "type": "integer", "minimum": 30000, "maximum": 3600000 },
        "maximum_idle_interval_ms": { "type": "integer", "minimum": 60000, "maximum": 86400000 },
        "jitter_ratio": { "type": "number", "minimum": 0, "maximum": 0.25 },
        "conservation_remaining": { "type": "integer", "minimum": 1 },
        "critical_reserve_remaining": { "type": "integer", "minimum": 1 },
        "conservation_ratio": { "type": "number", "minimum": 0.01, "maximum": 0.9 }
      }
    },
    "mailbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository", "issue_number", "trusted_authors", "allowed_author_associations", "bootstrap"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "issue_number": { "type": "integer", "minimum": 1 },
        "trusted_authors": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "maxLength": 100 } },
        "trusted_app_ids": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
        "allowed_author_associations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["OWNER", "MEMBER", "COLLABORATOR"] } },
        "bootstrap": { "type": "string", "enum": ["ignore_existing", "scan_existing"] }
      }
    },
    "checkout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "relative_path"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "relative_path": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "root", "worktree_root", "git_executable", "checkouts"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "root": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "worktree_root": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "git_executable": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "checkouts": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/checkout" } }
      }
    },
    "argumentRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "type": "string", "enum": ["literal", "prefix", "regex"] },
        "value": { "type": "string", "maxLength": 4096 },
        "repeat": { "type": "boolean" }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "executable", "fixed_args", "argument_rules", "capabilities", "stdin_modes", "workspace_ids", "maximum_timeout_ms", "maximum_output_bytes", "inherit_env", "secret_env_map"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "class": { "type": "string", "enum": ["deterministic", "build_or_test", "agent"] },
        "executable": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "fixed_args": { "type": "array", "maxItems": 128, "items": { "type": "string", "maxLength": 4096 } },
        "argument_rules": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/argumentRule" } },
        "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "stdin_modes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["none", "literal", "context_bundle"] } },
        "workspace_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "maximum_timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 86400000 },
        "maximum_output_bytes": { "type": "integer", "minimum": 1024, "maximum": 1073741824 },
        "inherit_env": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } },
        "secret_env_map": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } }
      }
    },
    "reporting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_update_interval_ms", "maximum_silence_ms", "maximum_comment_bytes", "redact_absolute_paths"],
      "properties": {
        "minimum_update_interval_ms": { "type": "integer", "minimum": 30000, "maximum": 3600000 },
        "maximum_silence_ms": { "type": "integer", "minimum": 60000, "maximum": 86400000 },
        "maximum_comment_bytes": { "type": "integer", "minimum": 4096, "maximum": 60000 },
        "redact_absolute_paths": { "type": "boolean" }
      }
    }
  }
}
